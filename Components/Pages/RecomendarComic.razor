@page "/sugerencias"

@using BovedaUru.Components.Modelo
@using BovedaUru.Servicios
@inject ComicServicio Servicio
@inject NavigationManager Nav

<PageTitle>Sugerir cómic - La Boveda de Uru</PageTitle>

<section aria-labelledby="titulo-sugerir">

    <h1 id="titulo-sugerir" class="h2 mb-4">Sugerir un cómic</h1>

    <EditForm Model="modelo" OnValidSubmit="Guardar" OnInvalidSubmit="MostrarErrores">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="titulo" class="form-label">Título</label>
            <InputText id="titulo" class="form-control" @bind-Value="modelo.Titulo" />
            <ValidationMessage For="() => modelo.Titulo" />
        </div>

        <div class="mb-3">
            <label for="editorial" class="form-label">Editorial</label>
            <InputSelect id="editorial" class="form-select" @bind-Value="modelo.Editorial">
                <option value="">Selecciona...</option>
                <option>Marvel Comics</option>
                <option>Dark Horse Comics</option>
                <option>Image Comics</option>
                <option>Otras Editoriales</option>
            </InputSelect>
            <ValidationMessage For="() => modelo.Editorial" />
        </div>

        <div class="mb-3">
            <label for="anio" class="form-label">Año (4 dígitos)</label>
            <InputText id="anio" class="form-control" @bind-Value="modelo.Año" />
            <ValidationMessage For="() => modelo.Año" />
        </div>

        <div class="mb-3">
            <label for="imagen" class="form-label">Imagen (ej. images/portada.jpg)</label>
            <InputText id="imagen" class="form-control" @bind-Value="modelo.Imagen" />
            <ValidationMessage For="() => modelo.Imagen" />
        </div>

        <div class="mb-3">
            <label for="descripcion" class="form-label">Descripción</label>
            <InputTextArea id="descripcion" class="form-control" rows="3" @bind-Value="modelo.Descripcion" />
            <ValidationMessage For="() => modelo.Descripcion" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Enviar sugerencia</button>
            <a class="btn btn-outline-secondary" href="catalogo">Cancelar</a>
        </div>
    </EditForm>

    @if (intentosFallidos > 0)
    {
        <p class="mt-3 text-muted">Intentos con errores: @intentosFallidos</p>
    }

</section>

@code
{
    private SugerenciaComic modelo = new();
    private int intentosFallidos;

    private async Task Guardar()
    {
        await Servicio.CrearAsync(new Comic
        {
            Personaje = "Varios",
            Grupo = "Sugerencias",
            Titulo = modelo.Titulo,
            Editorial = modelo.Editorial,
            Año = int.Parse(modelo.Año),
            Imagen = modelo.Imagen,
            Descripcion = modelo.Descripcion
        });

        Nav.NavigateTo("/catalogo");
    }

    private void MostrarErrores() => intentosFallidos++;
}