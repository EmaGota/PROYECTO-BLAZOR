    private List<Comic> comicsFiltrados = new();


    protected override async Task OnInitializedAsync()
    {
        comics = await Servicio.ObtenerTodosAsync();
        comicsFiltrados = comics.ToList();
    }


    private void Filtrar(FiltroComic filtros)
    {
        string personajeBuscado =
            filtros.Personaje.ToLower().Trim();

        string grupoBuscado =
            filtros.Grupo.ToLower().Trim();

        string editorialBuscada =
            filtros.Editorial.ToLower().Trim();


        comicsFiltrados = comics
            .Where(comic =>
                FiltrarPersonaje(comic, personajeBuscado) &&
                FiltrarGrupo(comic, grupoBuscado) &&
                FiltrarAño(comic, filtros.Año) &&
                FiltrarEditorial(comic, editorialBuscada)
            )
            .ToList();
    }


    private void AbrirRandom()
    {
        var conPagina = comics.Where(c => c.Id > 0).ToList();
        if(conPagina.Count == 0) return;

        var elegido = conPagina[Random.Shared.Next(conPagina.Count)];
        Navi.NavigateTo($"/Comic/{elegido.Id}");
    }


   private bool FiltrarPersonaje(
       Comic comic,
       string personajeBuscado)
   {
       if (personajeBuscado == "")
           return true;

       return comic.Personaje
           .ToLower()
           .Contains(personajeBuscado);
   }


   private bool FiltrarGrupo(
       Comic comic,
       string grupoBuscado)
   {
       if (grupoBuscado == "")
           return true;

       return comic.Grupo
           .ToLower()
           .Contains(grupoBuscado);
   }


   private bool FiltrarAño(
       Comic comic,
       string añoBuscado)
   {
       if (añoBuscado.Trim() == "")
           return true;

       if (!int.TryParse(
               añoBuscado.Trim(),
               out int año))
       {
           return false;
       }

       return comic.Año >= año &&
              comic.Año <= año + 9;
   }


   private bool FiltrarEditorial(
       Comic comic,
       string editorialBuscada)
   {
       if (editorialBuscada == "")
           return true;

       return comic.Editorial
           .ToLower()
           .Contains(editorialBuscada);
   }

}