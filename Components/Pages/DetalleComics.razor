@page "/comic/{Id:int}"
@using BovedaUru.Components.Pages
@using BovedaUru.Components.Modelo
@using BovedaUru.Servicios
@inject ComicServicio Servicio

<PageTitle>@(comic?.Titulo ?? "Cómic") - La Boveda de Uru</PageTitle>

@if (comic is null)
{
    <section>
        <h1 class="h2">No se encontró el cómic</h1>
        <a href="catalogo">← Volver al catálogo</a>
    </section>
}
else
{
    <article class="row g-4">

        <figure class="col-12 col-md-4 text-center mb-0">
            <img class="img-fluid rounded shadow" src="@comic.Imagen" alt="Portada de @comic.Titulo" />
        </figure>

        <div class="col-12 col-md-8">

            <header>
                <h1 class="h2">@comic.Titulo</h1>
                <p class="text-muted">@comic.Editorial - <time datetime="@comic.Año">@comic.Año</time></p>
            </header>

            <p>@comic.Descripcion</p>

            <EnlacesLectura Enlaces="comic.Enlaces" />

            <div class="d-flex flex-wrap gap-2 my-3">
               <Favoritos Comic="comic.Id" />
            <BotonCompartir />
</div>

            <a href="catalogo">← Volver al catálogo</a>

        </div>

    </article>
}

@code
{
    [Parameter] public int Id { get; set; }

    private Comic? comic;

    protected override void OnParametersSet()
    {
        comic = Servicio.ObtenerPorId(Id);
    }
}