<article class="personaje_tarjeta">

    <img src="@Imagen" alt="@Titulo">

    <div class="info_personaje">

        <h3>@Titulo</h3>

        <p>@Editorial - @Año</p>

    </div>

</article>


@code
{

    [Parameter] public string Titulo { get; set; } = "";

    [Parameter] public string Editorial { get; set; } = "";

    [Parameter] public int Año { get; set; }

    [Parameter] public string Imagen { get; set; } = "";

}
