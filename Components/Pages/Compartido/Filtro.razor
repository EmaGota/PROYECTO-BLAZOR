@using BovedaUru.Components.Modelo

<aside class="filtros">

    <h2>Filtros</h2>

    <div class="filtro">

        <label for="personaje">
            Personaje
        </label>

        <input type="text" id="personaje" class="form-control" @bind="filtros.Personaje" />

    </div>


    <div class="filtro">

        <label for="grupo">
            Grupo
        </label>

        <input type="text" id="grupo" class="form-control" @bind="filtros.Grupo" />

    </div>


    <div class="filtro">

        <label for="año">
            Año de lanzamiento
        </label>

        <input type="text" id="año" class="form-control" maxlength="4" inputmode="numeric" placeholder="Ej: 1990"
               oninput="this.value = this.value.replace(/\D/g, '')" @bind="filtros.Año" />

        @if (!string.IsNullOrEmpty(errorAño))
        {
            <p class="error_filtro">@errorAño</p>
        }

    </div>


    <div class="filtro">

        <label for="editorial">
            Editorial
        </label>

        <input type="text" id="editorial" class="form-control" @bind="filtros.Editorial" />

    </div>


    <button type="button" class="boton_filtro" @onclick="AplicarFiltro">

        Filtrar resultados

    </button>

</aside>


@code {

    private FiltroComic filtros = new();

    private string errorAño = "";


    [Parameter] public EventCallback<FiltroComic> OnFiltrar { get; set; }


    private async Task AplicarFiltro()
    {
        filtros.Año = filtros.Año.Trim();

        // El año puede quedar vacío (no filtra por año),
        // pero si se escribe debe tener exactamente 4 números.
        bool añoValido =
            filtros.Año == "" ||
            (filtros.Año.Length == 4 &&
             filtros.Año.All(c => c >= '0' && c <= '9'));

        if (!añoValido)
        {
            errorAño = "El año debe tener exactamente 4 números.";
            return;
        }

        errorAño = "";

        await OnFiltrar.InvokeAsync(filtros);
    }

}