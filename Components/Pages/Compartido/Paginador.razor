@if (TotalPaginas > 1)
{
    <nav aria-label="Paginación">
        <ul class="pagination justify-content-center">

            <li class="page-item @(Pagina == 1 ? "disabled" : "")">
                <button type="button" class="page-link" @onclick="() => Ir(Pagina - 1)">Anterior</button>
            </li>

            @for (var i = 1; i <= TotalPaginas; i++)
            {
                var p = i;
                <li class="page-item @(p == Pagina ? "active" : "")">
                    <button type="button" class="page-link" @onclick="() => Ir(p)">@p</button>
                </li>
            }

            <li class="page-item @(Pagina == TotalPaginas ? "disabled" : "")">
                <button type="button" class="page-link" @onclick="() => Ir(Pagina + 1)">Siguiente</button>
            </li>

        </ul>
    </nav>
}

@code
{
    [Parameter] public int Pagina { get; set; } = 1;
    [Parameter] public int TotalPaginas { get; set; }
    [Parameter] public EventCallback<int> OnCambioPagina { get; set; }

    private Task Ir(int p) =>
        p < 1 || p > TotalPaginas ? Task.CompletedTask : OnCambioPagina.InvokeAsync(p);
}