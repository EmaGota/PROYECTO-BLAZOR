{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "BovedaUru",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "ReSharper: Build",
            "program": "${workspaceFolder}/bin/Debug/net10.0/BovedaUru.dll",
            "cwd": "${workspaceFolder}",
            "args": [],
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        },
        {
            "name": "ReSharper: .NET Core / .NET 5+ Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:resharper.debugger.pickProcess.coreclr}"
        }
    ]
}